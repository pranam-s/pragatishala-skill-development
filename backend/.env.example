# PragatiShala backend configuration (copy to .env and fill in real values).
# NEVER commit a real .env - it is git-ignored.

# Required: JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NOTE: the example value below is deliberately rejected at startup - a value
# committed to git is publicly known, so the app refuses to boot until you
# replace it with your own generated key.
PRAGATISHALA_JWT_SECRET_KEY=change-me-generate-a-real-secret-with-secrets-token-urlsafe

# Database (default: local SQLite dev file; use MySQL in production, e.g.
# mysql+aiomysql://user:pass@host:3306/pragatishala)
#PRAGATISHALA_DATABASE_URL=sqlite+aiosqlite:///./pragatishala.db

# Comma-separated CORS origins for the frontend dev server
#PRAGATISHALA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI integration (Phase 2). Keys are read from the environment ONLY - never
# hardcoded. With "auto" the first configured provider wins; with no keys the
# platform falls back to the deterministic offline rule-based engine.
#PRAGATISHALA_AI_PROVIDER=auto
#PRAGATISHALA_OPENAI_API_KEY=
#PRAGATISHALA_OPENAI_BASE_URL=https://api.openai.com/v1
#PRAGATISHALA_OPENAI_MODEL=gpt-4o-mini
#PRAGATISHALA_ANTHROPIC_API_KEY=
#PRAGATISHALA_ANTHROPIC_BASE_URL=https://api.anthropic.com
#PRAGATISHALA_ANTHROPIC_MODEL=claude-sonnet-4-5
#PRAGATISHALA_AI_TIMEOUT_SECONDS=30

# Cache / realtime tuning
#PRAGATISHALA_MARKET_CACHE_MINUTES=1440
#PRAGATISHALA_SSE_KEEPALIVE_SECONDS=15

# Rate limiting (requests per minute per client; 0 disables a bucket).
# auth = login/register/refresh, generation = LLM-billed endpoints (ADR 0007)
#PRAGATISHALA_AUTH_RATE_LIMIT_PER_MINUTE=10
#PRAGATISHALA_GENERATION_RATE_LIMIT_PER_MINUTE=15

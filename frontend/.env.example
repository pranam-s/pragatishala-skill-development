# Frontend environment (copy to .env.local if you need to override).
# In development the Vite dev server proxies /api/v1 to the backend, so no
# configuration is required by default.

# Absolute API base for production builds where the SPA is not served behind
# the same origin as the API (must include the /api/v1 prefix):
#VITE_API_BASE_URL=https://api.example.com/api/v1
